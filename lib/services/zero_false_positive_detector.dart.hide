// 🚀 ZERO FALSE POSITIVE SCAM DETECTOR - PHASE 1
// Enterprise-grade, billion-dollar quality scam detection system
// Targets high-risk messaging apps with context-aware intelligence

import 'dart:async';
import 'dart:convert';
import 'dart:developer' as developer;
import 'package:flutter/foundation.dart';
import 'package:http/http.dart' as http;
import 'package:permission_handler/permission_handler.dart';
import 'package:crypto/crypto.dart';
import 'package:shared_preferences/shared_preferences.dart';
import '../core/intelligence/contact_intelligence_service.dart';
import '../core/intelligence/conversation_context_analyzer.dart';
import '../core/models/detection_models.dart';

// ===== CORE DATA MODELS =====

enum RiskLevel {
  none(0, "✅ Safe", "No risk detected"),
  low(1, "🟢 Low", "Minimal risk"),
  medium(2, "🟡 Medium", "Moderate risk - Review carefully"),
  high(3, "🟠 High", "High risk - Strong caution advised"),
  critical(4, "🔴 Critical", "SCAM DETECTED - IMMEDIATE ACTION REQUIRED");

  const RiskLevel(this.value, this.icon, this.description);
  final int value;
  final String icon;
  final String description;
}

enum ChannelType {
  sms("SMS", "📱", 0.8),
  whatsapp("WhatsApp", "💬", 0.9),
  telegram("Telegram", "✈️", 0.85),
  instagram("Instagram", "📷", 0.7),
  dating("Dating Apps", "💕", 0.95),
  messenger("Messenger", "💬", 0.75),
  signal("Signal", "🔒", 0.6),
  unknown("Unknown", "❓", 0.5);

  const ChannelType(this.name, this.icon, this.baseRiskMultiplier);
  final String name;
  final String icon;
  final double baseRiskMultiplier;
}

enum ContactTrustLevel {
  family(0.05, "👨‍👩‍👧‍👦 Family", "Immediate family member"),
  trustedFriend(0.1, "✅ Trusted Friend", "Long-term trusted contact"),
  knownContact(0.3, "📞 Known Contact", "Saved in contacts"),
  businessContact(0.4, "💼 Business", "Business or professional contact"),
  recentContact(0.6, "🆕 Recent", "Recently added contact"),
  unknown(0.9, "❓ Unknown", "Unknown sender"),
  suspicious(1.2, "⚠️ Suspicious", "Previously flagged as suspicious"),
  blocked(1.5, "🚫 Blocked", "Previously blocked contact");

  const ContactTrustLevel(this.riskMultiplier, this.label, this.description);
  final double riskMultiplier;
  final String label;
  final String description;
}

class ContactIntelligence {
  final String? displayName;
  final String phoneNumber;
  final ContactTrustLevel trustLevel;
  final bool isSavedContact;
  final int messageHistoryCount;
  final DateTime? lastContactDate;
  final List<String> previousInteractionTypes;
  final double trustScore; // 0.0 = complete stranger, 1.0 = family

  ContactIntelligence({
    this.displayName,
    required this.phoneNumber,
    required this.trustLevel,
    required this.isSavedContact,
    this.messageHistoryCount = 0,
    this.lastContactDate,
    this.previousInteractionTypes = const [],
    this.trustScore = 0.0,
  });

  factory ContactIntelligence.unknown(String phoneNumber) {
    return ContactIntelligence(
      phoneNumber: phoneNumber,
      trustLevel: ContactTrustLevel.unknown,
      isSavedContact: false,
      trustScore: 0.0,
    );
  }
}

class ConversationContext {
  final List<String> recentMessages;
  final Duration timeSinceLastMessage;
  final bool hasTopicShift; // Normal chat → money request
  final bool hasUrgencyEscalation; // Increasingly urgent messages
  final int consecutiveMoneyRequests;
  final Map<String, dynamic> behaviorPatterns;

  ConversationContext({
    this.recentMessages = const [],
    this.timeSinceLastMessage = Duration.zero,
    this.hasTopicShift = false,
    this.hasUrgencyEscalation = false,
    this.consecutiveMoneyRequests = 0,
    this.behaviorPatterns = const {},
  });
}

class ThreatIntelligence {
  final bool isScam;
  final RiskLevel riskLevel;
  final double confidence; // 0.0 - 1.0
  final double adjustedRisk; // Risk after contact/context adjustment
  final String primaryReason;
  final List<String> riskFactors;
  final List<String> scamTypes;
  final Map<String, dynamic> detailedAnalysis;
  final ContactIntelligence contactInfo;
  final ConversationContext? conversationContext;
  final DateTime timestamp;
  final String source;

  ThreatIntelligence({
    required this.isScam,
    required this.riskLevel,
    required this.confidence,
    required this.adjustedRisk,
    required this.primaryReason,
    this.riskFactors = const [],
    this.scamTypes = const [],
    this.detailedAnalysis = const {},
    required this.contactInfo,
    this.conversationContext,
    DateTime? timestamp,
    this.source = 'unknown',
  }) : timestamp = timestamp ?? DateTime.now();

  // Factory for safe (non-scam) results
  factory ThreatIntelligence.safe({
    required ContactIntelligence contactInfo,
    String reason = "No threats detected",
    String source = 'unknown',
  }) {
    return ThreatIntelligence(
      isScam: false,
      riskLevel: RiskLevel.none,
      confidence: 0.0,
      adjustedRisk: 0.0,
      primaryReason: reason,
      contactInfo: contactInfo,
      source: source,
    );
  }
}

// ===== MAIN DETECTION ENGINE =====

class ZeroFalsePositiveDetector extends ChangeNotifier {
  // ===== CONFIGURATION =====
  static const String _apiBaseUrl =
      'http://172.20.10.7:8000'; // Your machine's network IP
  // Production: 'https://elephas-ai-api.onrender.com'

  // Ultra-conservative thresholds for zero false positives
  static const double _criticalThreshold =
      0.95; // 95%+ confidence for critical alerts
  static const double _highThreshold = 0.90; // 90%+ for high risk
  static const double _mediumThreshold = 0.85; // 85%+ for medium risk
  static const int _minimumMessageLength = 15; // Ignore very short messages

  // Channel-specific targeting (HIGH-RISK ONLY)
  static const Map<String, ChannelType> _targetChannels = {
    'com.whatsapp': ChannelType.whatsapp,
    'org.telegram.messenger': ChannelType.telegram,
    'com.instagram.android': ChannelType.instagram,
    'com.facebook.orca': ChannelType.messenger,
    'com.android.mms': ChannelType.sms,
    'com.google.android.apps.messaging': ChannelType.sms,
    'com.tinder': ChannelType.dating,
    'com.bumble.app': ChannelType.dating,
    'com.hinge.co': ChannelType.dating,
    'org.thoughtcrime.securesms': ChannelType.signal,
  };

  // ===== STATE MANAGEMENT =====
  bool _isInitialized = false;
  bool _isScanning = false;
  final Map<String, ContactIntelligence> _contactCache = {};
  final Map<String, ThreatIntelligence> _analysisCache = {};
  final Map<String, List<String>> _conversationHistory = {};

  // Statistics
  int _totalScansPerformed = 0;
  int _threatsDetected = 0;
  int _falsePositivesPrevented = 0;

  // ===== GETTERS =====
  bool get isInitialized => _isInitialized;
  bool get isScanning => _isScanning;
  int get totalScansPerformed => _totalScansPerformed;
  int get threatsDetected => _threatsDetected;
  int get falsePositivesPrevented => _falsePositivesPrevented;
  double get accuracy => _totalScansPerformed > 0
      ? ((_totalScansPerformed - _falsePositivesPrevented) /
          _totalScansPerformed)
      : 1.0;

  // ===== INITIALIZATION =====

  Future<void> initialize() async {
    if (_isInitialized) return;

    developer.log('🚀 Initializing Zero False Positive Detector...',
        name: 'ZFPDetector');

    try {
      // Initialize contact system
      await _initializeContactSystem();

      // Load conversation history
      await _loadConversationHistory();

      // Test API connection
      await _testApiConnection();

      _isInitialized = true;
      developer.log('✅ Zero False Positive Detector initialized successfully',
          name: 'ZFPDetector');
    } catch (e) {
      developer.log('❌ Failed to initialize detector: $e', name: 'ZFPDetector');
      throw Exception('Critical system initialization failed: $e');
    }
  }

  Future<void> _initializeContactSystem() async {
    try {
      // Request contacts permission
      final permission = await Permission.contacts.request();
      if (!permission.isGranted) {
        developer.log('⚠️ Contacts permission not granted - using limited mode',
            name: 'ZFPDetector');
        return;
      }

      developer.log('📋 Building contact intelligence database...',
          name: 'ZFPDetector');

      // Load and analyze all contacts
      final contacts = <MockContact>[];
      int processedContacts = 0;

      for (final contact in contacts) {
        for (final phone in contact.phones ?? []) {
          final normalizedPhone = _normalizePhoneNumber(phone.value ?? '');
          if (normalizedPhone.isNotEmpty) {
            final intelligence =
                await _buildContactIntelligence(contact, normalizedPhone);
            _contactCache[normalizedPhone] = intelligence;
            processedContacts++;
          }
        }
      }

      developer.log(
          '✅ Contact intelligence: $processedContacts contacts analyzed',
          name: 'ZFPDetector');
    } catch (e) {
      developer.log('❌ Contact system initialization failed: $e',
          name: 'ZFPDetector');
    }
  }

  Future<ContactIntelligence> _buildContactIntelligence(
      MockContact contact, String phoneNumber) async {
    final displayName = contact.displayName ?? '';

    // Determine trust level based on name patterns and history
    ContactTrustLevel trustLevel = ContactTrustLevel.knownContact;
    double trustScore = 0.5;

    // Family member detection (enhanced)
    final familyPatterns = [
      'mom',
      'dad',
      'mother',
      'father',
      'papa',
      'mama',
      'mummy',
      'daddy',
      'brother',
      'sister',
      'bro',
      'sis',
      'uncle',
      'aunt',
      'aunty',
      'cousin',
      'grandpa',
      'grandma',
      'nana',
      'nani',
      'dada',
      'dadi',
      'wife',
      'husband',
      'beta',
      'beti',
      'son',
      'daughter',
      'beta',
      'putri',
      'maa',
      'baap'
    ];

    final lowerName = displayName.toLowerCase();
    if (familyPatterns.any((pattern) => lowerName.contains(pattern))) {
      trustLevel = ContactTrustLevel.family;
      trustScore = 0.95;
    }

    // Business contact detection
    final businessPatterns = [
      'bank',
      'doctor',
      'dr.',
      'service',
      'support',
      'office',
      'company',
      'shop',
      'store',
      'delivery',
      'restaurant',
      'hotel',
      'hospital'
    ];

    if (businessPatterns.any((pattern) => lowerName.contains(pattern))) {
      trustLevel = ContactTrustLevel.businessContact;
      trustScore = 0.6;
    }

    return ContactIntelligence(
      displayName: displayName,
      phoneNumber: phoneNumber,
      trustLevel: trustLevel,
      isSavedContact: true,
      trustScore: trustScore,
      messageHistoryCount: 0, // Will be populated from message history
    );
  }

  Future<void> _loadConversationHistory() async {
    try {
      final prefs = await SharedPreferences.getInstance();
      final historyJson = prefs.getString('conversation_history') ?? '{}';
      final Map<String, dynamic> history = json.decode(historyJson);

      for (final entry in history.entries) {
        _conversationHistory[entry.key] = List<String>.from(entry.value);
      }

      developer.log(
          '📚 Loaded conversation history for ${_conversationHistory.length} contacts',
          name: 'ZFPDetector');
    } catch (e) {
      developer.log('⚠️ Failed to load conversation history: $e',
          name: 'ZFPDetector');
    }
  }

  Future<void> _testApiConnection() async {
    try {
      final response = await http.get(
        Uri.parse('$_apiBaseUrl/health'),
        headers: {'Content-Type': 'application/json'},
      ).timeout(const Duration(seconds: 5));

      if (response.statusCode == 200) {
        developer.log('✅ API connection verified', name: 'ZFPDetector');
      } else {
        throw Exception('API health check failed: ${response.statusCode}');
      }
    } catch (e) {
      developer.log('⚠️ API connection failed - using offline mode: $e',
          name: 'ZFPDetector');
      // Continue in offline mode with reduced capabilities
    }
  }

  // ===== CORE DETECTION METHODS =====

  /// Main detection method - the heart of the billion-dollar system
  Future<ThreatIntelligence> analyzeMessage({
    required String messageText,
    required String senderIdentifier, // Phone number or username
    required ChannelType channel,
    Map<String, dynamic>? metadata,
  }) async {
    if (!_isInitialized) {
      throw Exception('System not initialized - call initialize() first');
    }

    _isScanning = true;
    _totalScansPerformed++;
    notifyListeners();

    try {
      developer.log(
          '🔍 Analyzing message from $senderIdentifier via ${channel.name}',
          name: 'ZFPDetector');

      // === PHASE 1: PRE-SCREENING ===
      final preScreenResult = await _performPreScreening(messageText, channel);
      if (preScreenResult != null) {
        _falsePositivesPrevented++;
        return preScreenResult;
      }

      // === PHASE 2: CONTACT INTELLIGENCE ===
      final contactInfo = await _getContactIntelligence(senderIdentifier);

      // === PHASE 3: CONVERSATION CONTEXT ===
      final conversationContext =
          await _buildConversationContext(senderIdentifier, messageText);

      // === PHASE 4: THREAT ANALYSIS ===
      final threatAnalysis = await _performThreatAnalysis(
          messageText, contactInfo, conversationContext, channel);

      // === PHASE 5: RISK CALCULATION ===
      final finalResult = await _calculateFinalRisk(
          threatAnalysis, contactInfo, conversationContext, channel);

      // Update conversation history
      await _updateConversationHistory(senderIdentifier, messageText);

      // Cache result
      final cacheKey = _generateCacheKey(messageText, senderIdentifier);
      _analysisCache[cacheKey] = finalResult;

      if (finalResult.isScam) {
        _threatsDetected++;
        developer.log('🚨 THREAT DETECTED: ${finalResult.primaryReason}',
            name: 'ZFPDetector');
      }

      return finalResult;
    } catch (e) {
      developer.log('❌ Analysis failed: $e', name: 'ZFPDetector');
      return ThreatIntelligence.safe(
        contactInfo: ContactIntelligence.unknown(senderIdentifier),
        reason: 'Analysis failed: $e',
      );
    } finally {
      _isScanning = false;
      notifyListeners();
    }
  }

  /// Pre-screening to eliminate obvious false positives
  Future<ThreatIntelligence?> _performPreScreening(
      String message, ChannelType channel) async {
    // Too short - likely not a scam
    if (message.trim().length < _minimumMessageLength) {
      return ThreatIntelligence.safe(
        contactInfo: ContactIntelligence.unknown(''),
        reason: 'Message too short for analysis',
      );
    }

    // Casual conversation patterns (ultra-conservative)
    final casualPatterns = [
      // English casual
      RegExp(
          r'\b(hey|hi|hello|thanks|ok|okay|bye|meeting|appointment|dinner|lunch|movie|work|office|home|family)\b',
          caseSensitive: false),

      // Hindi casual
      RegExp(r'\b(नमस्ते|हैलो|धन्यवाद|ठीक|अच्छा|बाई)\b', caseSensitive: false),

      // Phrases with spaces - separate patterns
      RegExp(r'how are you', caseSensitive: false),
      RegExp(r'good morning', caseSensitive: false),
      RegExp(r'good night', caseSensitive: false),
      RegExp(r'see you', caseSensitive: false),
      RegExp(r'take care', caseSensitive: false),
    ];

    final lowerMessage = message.toLowerCase();

    // If purely casual AND no urgent/money keywords, skip
    bool isCasual = casualPatterns.any((pattern) => pattern.hasMatch(message));
    bool hasUrgentKeywords = RegExp(
            r'\b(urgent|immediate|expire|winner|prize|money|cash|loan|offer|click|link|otp|bank|verify)\b',
            caseSensitive: false)
        .hasMatch(lowerMessage);

    if (isCasual && !hasUrgentKeywords) {
      return ThreatIntelligence.safe(
        contactInfo: ContactIntelligence.unknown(''),
        reason: 'Casual conversation detected',
      );
    }

    // Legitimate domains/services (be very inclusive to prevent false positives)
    final legitimateDomains = [
      'google.com',
      'youtube.com',
      'amazon.com',
      'flipkart.com',
      'paytm.com',
      'banks.com',
      'sbi.co.in',
      'hdfc.com',
      'icici.com',
      'axis.com',
      'gov.in',
      'uidai.gov.in',
      'mygov.in',
      'irctc.co.in',
      'zomato.com',
      'swiggy.com',
      'ola.com',
      'uber.com'
    ];

    if (legitimateDomains.any((domain) => lowerMessage.contains(domain))) {
      return ThreatIntelligence.safe(
        contactInfo: ContactIntelligence.unknown(''),
        reason: 'Legitimate service detected',
      );
    }

    return null; // Proceed with full analysis
  }

  /// Get comprehensive contact intelligence
  Future<ContactIntelligence> _getContactIntelligence(String identifier) async {
    final normalizedId = _normalizePhoneNumber(identifier);

    // Check cache first
    if (_contactCache.containsKey(normalizedId)) {
      return _contactCache[normalizedId]!;
    }

    // Unknown contact - build basic intelligence
    final intelligence = ContactIntelligence.unknown(normalizedId);
    _contactCache[normalizedId] = intelligence;

    return intelligence;
  }

  /// Build conversation context for behavioral analysis
  Future<ConversationContext> _buildConversationContext(
      String sender, String currentMessage) async {
    final history = _conversationHistory[sender] ?? [];

    // Add current message to history (keep last 10 messages)
    history.add(currentMessage);
    if (history.length > 10) {
      history.removeAt(0);
    }

    // Analyze patterns
    bool hasTopicShift = _detectTopicShift(history);
    bool hasUrgencyEscalation = _detectUrgencyEscalation(history);
    int consecutiveMoneyRequests = _countConsecutiveMoneyRequests(history);

    return ConversationContext(
      recentMessages: List.from(history),
      hasTopicShift: hasTopicShift,
      hasUrgencyEscalation: hasUrgencyEscalation,
      consecutiveMoneyRequests: consecutiveMoneyRequests,
    );
  }

  /// Perform advanced threat analysis using AI backend
  Future<Map<String, dynamic>> _performThreatAnalysis(
    String message,
    ContactIntelligence contactInfo,
    ConversationContext context,
    ChannelType channel,
  ) async {
    try {
      final response = await http
          .post(
            Uri.parse('$_apiBaseUrl/scan'),
            headers: {'Content-Type': 'application/json'},
            body: json.encode({
              'text': message,
              'sender': contactInfo.phoneNumber,
              'contact_name': contactInfo.displayName,
              'phone_number': contactInfo.phoneNumber,
              'is_saved_contact': contactInfo.isSavedContact,
              'message_history_count': contactInfo.messageHistoryCount,
              'trust_level': contactInfo.trustLevel.name,
              'trust_score': contactInfo.trustScore,
              'channel': channel.name,
              'conversation_context': {
                'recent_message_count': context.recentMessages.length,
                'has_topic_shift': context.hasTopicShift,
                'has_urgency_escalation': context.hasUrgencyEscalation,
                'consecutive_money_requests': context.consecutiveMoneyRequests,
              },
              'metadata': {
                'platform': 'flutter',
                'detector_version': '2.0.0',
                'timestamp': DateTime.now().toIso8601String(),
              }
            }),
          )
          .timeout(const Duration(seconds: 15));

      if (response.statusCode == 200) {
        return json.decode(response.body);
      } else {
        throw Exception('API request failed: ${response.statusCode}');
      }
    } catch (e) {
      developer.log('⚠️ Threat analysis API failed, using fallback: $e',
          name: 'ZFPDetector');
      return await _performFallbackAnalysis(message);
    }
  }

  /// Calculate final risk score with all context factors
  Future<ThreatIntelligence> _calculateFinalRisk(
    Map<String, dynamic> analysis,
    ContactIntelligence contactInfo,
    ConversationContext context,
    ChannelType channel,
  ) async {
    // Base risk from AI analysis
    final baseRisk = (analysis['risk_score'] as num?)?.toDouble() ?? 0.0;
    final confidence = (analysis['confidence'] as num?)?.toDouble() ?? 0.0;

    // Contact trust adjustment (MAJOR factor for zero false positives)
    double contactAdjustment = contactInfo.trustLevel.riskMultiplier;

    // Family members get massive risk reduction
    if (contactInfo.trustLevel == ContactTrustLevel.family) {
      contactAdjustment = 0.05; // 95% risk reduction for family
    }

    // Channel risk multiplier
    double channelMultiplier = channel.baseRiskMultiplier;

    // Conversation context adjustments
    double contextAdjustment = 1.0;
    if (context.hasTopicShift) contextAdjustment += 0.2;
    if (context.hasUrgencyEscalation) contextAdjustment += 0.3;
    if (context.consecutiveMoneyRequests > 1) contextAdjustment += 0.4;

    // Calculate adjusted risk
    double adjustedRisk =
        baseRisk * contactAdjustment * channelMultiplier * contextAdjustment;

    // Ensure we don't exceed 1.0
    adjustedRisk = adjustedRisk.clamp(0.0, 1.0);

    // Determine risk level with ultra-conservative thresholds
    RiskLevel riskLevel = RiskLevel.none;
    bool isScam = false;

    if (adjustedRisk >= _criticalThreshold) {
      riskLevel = RiskLevel.critical;
      isScam = true;
    } else if (adjustedRisk >= _highThreshold) {
      riskLevel = RiskLevel.high;
      isScam = true;
    } else if (adjustedRisk >= _mediumThreshold) {
      riskLevel = RiskLevel.medium;
      isScam = true;
    }

    // Additional safety check - never flag family as scam unless EXTREMELY high confidence
    if (contactInfo.trustLevel == ContactTrustLevel.family &&
        adjustedRisk < 0.98) {
      isScam = false;
      riskLevel = RiskLevel.none;
    }

    return ThreatIntelligence(
      isScam: isScam,
      riskLevel: riskLevel,
      confidence: confidence,
      adjustedRisk: adjustedRisk,
      primaryReason: analysis['explanation'] ?? 'Risk analysis completed',
      riskFactors: List<String>.from(analysis['risk_factors'] ?? []),
      scamTypes: List<String>.from(analysis['scam_types'] ?? []),
      detailedAnalysis: analysis,
      contactInfo: contactInfo,
      conversationContext: context,
      source: 'ai_analysis',
    );
  }

  // ===== UTILITY METHODS =====

  String _normalizePhoneNumber(String phone) {
    // Remove all non-digits
    String normalized = phone.replaceAll(RegExp(r'[^\d]'), '');

    // Handle Indian numbers
    if (normalized.length == 10) {
      normalized = '91$normalized'; // Add country code
    } else if (normalized.startsWith('0') && normalized.length == 11) {
      normalized = '91${normalized.substring(1)}'; // Replace 0 with 91
    }

    return normalized;
  }

  String _generateCacheKey(String message, String sender) {
    final combined = '$message|$sender';
    return sha256.convert(utf8.encode(combined)).toString();
  }

  bool _detectTopicShift(List<String> messages) {
    if (messages.length < 2) return false;

    // Look for sudden shift from casual to money/urgent topics
    final lastMessage = messages.last.toLowerCase();
    final previousMessages = messages
        .take(messages.length - 1)
        .map((m) => m.toLowerCase())
        .join(' ');

    bool currentHasMoneyTopic =
        RegExp(r'\b(money|cash|rupee|₹|loan|pay|send|transfer|account|bank)\b')
            .hasMatch(lastMessage);
    bool previousHadCasualTopic = previousMessages.contains('good') ||
        previousMessages.contains('fine') ||
        previousMessages.contains('ok') ||
        previousMessages.contains('family') ||
        previousMessages.contains('work') ||
        previousMessages.contains('food') ||
        previousMessages.contains('weather') ||
        RegExp(r'how are you').hasMatch(previousMessages);

    return currentHasMoneyTopic && previousHadCasualTopic;
  }

  bool _detectUrgencyEscalation(List<String> messages) {
    if (messages.length < 2) return false;

    final urgencyPattern = RegExp(
        r'\b(urgent|immediately|asap|quick|fast|now|right now|hurry)\b',
        caseSensitive: false);

    int urgencyCount = 0;
    for (int i = messages.length - 3; i < messages.length; i++) {
      if (i >= 0 && urgencyPattern.hasMatch(messages[i])) {
        urgencyCount++;
      }
    }

    return urgencyCount >= 2; // Multiple urgent messages in recent history
  }

  int _countConsecutiveMoneyRequests(List<String> messages) {
    final moneyPattern = RegExp(
        r'\b(money|cash|rupee|₹|loan|pay|send|transfer|need.*money|emergency.*money)\b',
        caseSensitive: false);

    int consecutiveCount = 0;
    for (int i = messages.length - 1; i >= 0; i--) {
      if (moneyPattern.hasMatch(messages[i])) {
        consecutiveCount++;
      } else {
        break;
      }
    }

    return consecutiveCount;
  }

  Future<Map<String, dynamic>> _performFallbackAnalysis(String message) async {
    // Basic keyword-based fallback when API is unavailable
    final scamKeywords = [
      'congratulations winner',
      'click here claim',
      'account suspended verify',
      'urgent action required',
      'free iphone',
      'lottery winner',
      'prize money',
      'bank account blocked',
      'otp verification',
      'immediate payment required'
    ];

    final lowerMessage = message.toLowerCase();
    double riskScore = 0.0;
    List<String> matchedKeywords = [];

    for (final keyword in scamKeywords) {
      if (lowerMessage.contains(keyword)) {
        riskScore += 0.3;
        matchedKeywords.add(keyword);
      }
    }

    return {
      'risk_score': riskScore.clamp(0.0, 1.0),
      'confidence': matchedKeywords.isNotEmpty ? 0.7 : 0.3,
      'explanation': matchedKeywords.isNotEmpty
          ? 'Suspicious keywords detected: ${matchedKeywords.join(', ')}'
          : 'No suspicious patterns detected',
      'risk_factors': matchedKeywords,
      'scam_types': matchedKeywords.isNotEmpty ? ['keyword_match'] : [],
    };
  }

  Future<void> _updateConversationHistory(String sender, String message) async {
    final history = _conversationHistory[sender] ?? [];
    history.add(message);

    // Keep only last 10 messages per contact
    if (history.length > 10) {
      history.removeAt(0);
    }

    _conversationHistory[sender] = history;

    // Persist to storage
    try {
      final prefs = await SharedPreferences.getInstance();
      await prefs.setString(
          'conversation_history', json.encode(_conversationHistory));
    } catch (e) {
      developer.log('Failed to save conversation history: $e',
          name: 'ZFPDetector');
    }
  }

  // ===== PUBLIC UTILITY METHODS =====

  /// Check if a channel/app should be monitored
  bool shouldMonitorChannel(String packageName) {
    return _targetChannels.containsKey(packageName);
  }

  /// Get channel type from package name
  ChannelType getChannelType(String packageName) {
    return _targetChannels[packageName] ?? ChannelType.unknown;
  }

  /// Clear all caches and reset
  Future<void> clearCaches() async {
    _contactCache.clear();
    _analysisCache.clear();
    _conversationHistory.clear();

    final prefs = await SharedPreferences.getInstance();
    await prefs.remove('conversation_history');

    developer.log('🧹 All caches cleared', name: 'ZFPDetector');
  }

  /// Get system statistics
  Map<String, dynamic> getSystemStats() {
    return {
      'total_scans': _totalScansPerformed,
      'threats_detected': _threatsDetected,
      'false_positives_prevented': _falsePositivesPrevented,
      'accuracy': accuracy,
      'contacts_cached': _contactCache.length,
      'conversations_tracked': _conversationHistory.length,
      'target_channels': _targetChannels.length,
      'is_initialized': _isInitialized,
    };
  }
}

// Mock classes to replace missing contacts_service dependency
class MockContact {
  final String? displayName;
  final List<MockPhone>? phones;

  MockContact({this.displayName, this.phones});
}

class MockPhone {
  final String? value;

  MockPhone({this.value});
}
